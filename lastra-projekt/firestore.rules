rules_version = '2';

// Lastra Projekt – Firestore security rules
// Public: anyone may READ the site settings and PUBLISHED projects (that is all the website needs).
// Admin:  only the signed-in admin account may create / update / delete anything.
// Replace ADMIN_EMAIL_HERE with your admin login email (exactly as in Firebase Authentication).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ADMIN_EMAIL_HERE";
    }

    // site/settings – contact details, architect, estimator, 3D model URLs
    match /site/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // projects/{id} – visitors only ever see published projects; the admin sees everything
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'title', 'status'])
        && request.resource.data.status in ['finished', 'progress'];
      allow delete: if isAdmin();
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
