{
  "name": "evora-website",
  "version": "1.0.0",
  "private": true,
  "description": "Evora — Bath & Design · sanitaryware & ceramic tiles showroom website with procedural Three.js scenes",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=assets/app.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=assets/app.js --watch --servedir=. --serve=5173",
    "serve": "python3 -m http.server 5173"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
